# Ejemplos de desarrollo. Spring NO carga .env automáticamente.
# Exportar variables o usar un fichero externo application.yml.
BIND_ADDRESS=127.0.0.1
PORT=8080
DATA_DIR=./data
# Opcional: siempre un archivo local, nunca una unidad de red.
# DATABASE_URL=jdbc:sqlite:/ruta/absoluta/brilliant.db
PUBLIC_ORIGIN=http://localhost:8080
PRODUCTION=false
# Archivo local de usuarios/contraseñas de prueba: true por defecto en perfil lan.
# Nunca usar con PRODUCTION=true.
RECORD_TEST_ACCOUNTS=false
JWT_ISSUER=brilliant-server
JWT_AUDIENCE=brilliant-game
ACCESS_SECONDS=600
SESSION_SECONDS=2592000
# Solo si existe cliente web; lista separada por comas, sin comodines.
ALLOWED_ORIGINS=
LOGIN_IP_LIMIT=10
LOGIN_NAME_LIMIT=5
REGISTER_IP_LIMIT=5
REFRESH_LIMIT=30
ACCOUNT_LIMIT=5
# Producción: certificado válido para el host público y HTTPS obligatorio.
# PUBLIC_ORIGIN=https://cuentas.example.com:8443
# PRODUCTION=true
# PORT=8443
# SERVER_SSL_ENABLED=true
# SERVER_SSL_KEY_STORE=file:/ruta/privada/server.p12
# SERVER_SSL_KEY_STORE_TYPE=PKCS12
# SERVER_SSL_KEY_STORE_PASSWORD=<configurar-fuera-del-repositorio>
